{
  "name": "the-web-dudes/craft-image-url-transformer",
  "type": "craft-plugin",
  "license": "mit",
  "require": {
    "php": ">=8.3",
    "craftcms/cms": "^5.8.0"
  },
  "autoload": {
    "psr-4": {
      "thewebdudes\\craftimageurltransformer\\": "src/"
    }
  },
  "extra": {
    "handle": "image-url-transformer",
    "name": "Image Url Transformer",
    "developer": "@the-web-dudes",
    "documentationUrl": "",
    "class": "thewebdudes\\craftimageurltransformer\\ImageUrlTransformer"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}